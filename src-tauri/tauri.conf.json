{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenBrep",
  "version": "0.9.1",
  "identifier": "com.openbrep.app",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:8766",
    "beforeDevCommand": "python3 ../scripts/obr7.py --tauri",
    "beforeBuildCommand": "cd ../frontend && npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenBrep — AI GDL Workbench",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/obr7-backend"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVGNDE3QTVBRjZCRjg5NDYKUldSR2liLzJXbnBCWDNqTVJ2bnc4VHBkTFI1WTllYWF4R2RQTHZiZm5GbWFNWm92UDREaXFzM1oK",
      "endpoints": [
        "https://github.com/byewind1/openbrep/releases/latest/download/latest.json"
      ]
    }
  }
}
