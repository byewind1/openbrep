{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenBrep",
  "version": "1.0.0",
  "identifier": "com.openbrep.app",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:8766",
    "beforeDevCommand": "python3 scripts/obr7.py --tauri",
    "beforeBuildCommand": "cd frontend && npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenBrep — AI GDL Workbench",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "externalBin": []
  }
}
