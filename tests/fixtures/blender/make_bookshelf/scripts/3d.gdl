! Generated by BS2G from Blender script: make_bookshelf
! Parameters: width, depth, height, shelf_count, panel_thickness

spacing = height / (shelf_count + 1)

ADD -1 * width / 2, 0, height / 2
MUL panel_thickness, depth, height
ADD -0.5, -0.5, -0.5
BLOCK 1, 1, 1
DEL 3
ADD 1 * width / 2, 0, height / 2
MUL panel_thickness, depth, height
ADD -0.5, -0.5, -0.5
BLOCK 1, 1, 1
DEL 3
FOR i = 0 TO shelf_count - 1
    ADD 0, 0, spacing * (i + 1)
    MUL width, depth, panel_thickness
    ADD -0.5, -0.5, -0.5
    BLOCK 1, 1, 1
    DEL 3
NEXT i

END
